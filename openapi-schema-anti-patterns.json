{
  "openapi": "3.0.3",
  "info": {
    "title": "TechVNManagement",
    "version": "1.0.0",
    "description": "HR Management API for querying and managing employees, departments, and projects at TechVN"
  },
  "servers": [
    {
      "url": "https://my-json-server.typicode.com/haovuhd/aws-quick-openapi-anti-pattern"
    }
  ],
  "paths": {
    "/employees": {
      "get": {
        "operationId": "GetAllEmployees",
        "description": "Return all employees",
        "parameters": [],
        "responses": {
          "200": {
            "description": "A list of employees",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Employee"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "CreateEmployee",
        "description": "Create a new employee record",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "employee_name": {
                    "type": "string",
                    "description": "Full name of the employee"
                  },
                  "email": {
                    "type": "string",
                    "description": "Email address"
                  },
                  "department": {
                    "type": "object",
                    "description": "Department information",
                    "properties": {
                      "id": { "type": "integer" },
                      "name": { "type": "string" },
                      "location": { "type": "string" }
                    },
                    "required": ["name"]
                  },
                  "job_title": {
                    "type": "string",
                    "description": "Job title"
                  },
                  "compensation": {
                    "type": "object",
                    "description": "Salary and bonus details",
                    "properties": {
                      "base_salary": { "type": "integer" },
                      "bonus": { "type": "integer" },
                      "currency": { "type": "string" }
                    },
                    "required": ["base_salary"]
                  },
                  "employment_status": {
                    "type": "string",
                    "description": "Current employment status"
                  },
                  "contract_period": {
                    "type": "object",
                    "description": "Contract date range",
                    "properties": {
                      "start_date": {
                        "type": "string",
                        "format": "date",
                        "description": "Contract start date in ISO-8601 format (YYYY-MM-DD)"
                      },
                      "end_date": {
                        "type": "string",
                        "format": "date",
                        "description": "Contract end date in ISO-8601 format (YYYY-MM-DD), or leave empty if still active"
                      }
                    },
                    "required": ["start_date"]
                  },
                  "skills": {
                    "type": "string",
                    "description": "Comma-separated list of skills, for example Python, FastAPI, PostgreSQL"
                  },
                  "certifications": {
                    "type": "string",
                    "description": "Comma-separated list of certifications with dates, for example ISTQB Foundation (2023-09-15), AWS Developer (2024-01-10)"
                  },
                  "manager": {
                    "type": "object",
                    "description": "Direct manager",
                    "properties": {
                      "id": {
                        "type": "integer",
                        "description": "Manager employee ID"
                      },
                      "name": {
                        "type": "string",
                        "description": "Manager full name"
                      }
                    }
                  }
                },
                "required": ["employee_name", "department", "job_title", "compensation", "employment_status"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created employee",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Employee"
                }
              }
            }
          }
        }
      }
    },
    "/employees/{id}": {
      "get": {
        "operationId": "GetEmployeeById",
        "description": "Get a single employee by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Employee ID",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employee details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Employee"
                }
              }
            }
          }
        }
      }
    },
    "/departments": {
      "get": {
        "operationId": "GetAllDepartments",
        "description": "Return all departments",
        "parameters": [],
        "responses": {
          "200": {
            "description": "A list of departments",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Department"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/departments/{id}": {
      "get": {
        "operationId": "GetDepartmentById",
        "description": "Get a single department by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Department ID",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Department details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Department"
                }
              }
            }
          }
        }
      }
    },
    "/projects": {
      "get": {
        "operationId": "GetAllProjects",
        "description": "Return all projects",
        "parameters": [],
        "responses": {
          "200": {
            "description": "A list of projects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Project"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/projects/{id}": {
      "get": {
        "operationId": "GetProjectById",
        "description": "Get a single project by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Project ID",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Employee": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "employee_name": { "type": "string" },
          "email": { "type": "string" },
          "department": {
            "type": "object",
            "properties": {
              "id": { "type": "integer" },
              "name": { "type": "string" },
              "location": { "type": "string" }
            }
          },
          "job_title": { "type": "string" },
          "compensation": {
            "type": "object",
            "properties": {
              "base_salary": { "type": "integer" },
              "bonus": { "type": "integer" },
              "currency": { "type": "string" }
            }
          },
          "employment_status": { "type": "string" },
          "contract_period": {
            "type": "object",
            "properties": {
              "start_date": { "type": "string", "format": "date" },
              "end_date": {
                "anyOf": [
                  { "type": "string", "format": "date" },
                  { "type": "null" }
                ]
              }
            }
          },
          "skills": {
            "type": "array",
            "items": { "type": "string" }
          },
          "certifications": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "issued_date": { "type": "string", "format": "date" }
              }
            }
          },
          "manager": {
            "type": "object",
            "properties": {
              "id": {
                "anyOf": [
                  { "type": "integer" },
                  { "type": "null" }
                ]
              },
              "name": {
                "anyOf": [
                  { "type": "string" },
                  { "type": "null" }
                ]
              }
            }
          }
        }
      },
      "Department": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "department_name": { "type": "string" },
          "headcount": { "type": "integer" },
          "budget": {
            "type": "object",
            "properties": {
              "annual": { "type": "integer" },
              "spent": { "type": "integer" },
              "currency": { "type": "string" }
            }
          },
          "head": {
            "type": "object",
            "properties": {
              "id": { "type": "integer" },
              "name": { "type": "string" },
              "email": { "type": "string" }
            }
          },
          "location": {
            "type": "object",
            "properties": {
              "city": { "type": "string" },
              "state": { "type": "string" },
              "country": { "type": "string" }
            }
          },
          "sub_teams": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "project_name": { "type": "string" },
          "department": {
            "type": "object",
            "properties": {
              "id": { "type": "integer" },
              "name": { "type": "string" }
            }
          },
          "project_status": { "type": "string" },
          "timeline": {
            "type": "object",
            "properties": {
              "start_date": { "type": "string", "format": "date" },
              "end_date": { "type": "string", "format": "date" },
              "milestones": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "due_date": { "type": "string", "format": "date" },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          },
          "budget": {
            "type": "object",
            "properties": {
              "allocated": { "type": "integer" },
              "spent": { "type": "integer" },
              "currency": { "type": "string" }
            }
          },
          "lead": {
            "type": "object",
            "properties": {
              "id": { "type": "integer" },
              "name": { "type": "string" }
            }
          },
          "team_members": {
            "type": "array",
            "items": { "type": "integer" }
          }
        }
      }
    }
  }
}
