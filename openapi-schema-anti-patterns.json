{
  "openapi": "3.0.3",
  "info": {
    "title": "HRManagement-AntiPatterns",
    "version": "1.0.0",
    "description": "DO NOT USE IN PRODUCTION. This schema uses nested objects, arrays, anyOf, and other patterns that break or reduce accuracy in Amazon Q Business agents. Compare with openapi-schema.json (flattened version) to see the difference."
  },
  "servers": [
    {
      "url": "https://my-json-server.typicode.com/haovuhd/aws-quick-openapi"
    }
  ],
  "paths": {
    "/employees": {
      "get": {
        "operationId": "GetAllEmployees",
        "description": "Return all employees",
        "parameters": [],
        "responses": {
          "200": {
            "description": "A list of employees",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Employee"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "CreateEmployee",
        "description": "Create a new employee",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "employee_name": {
                    "type": "string",
                    "description": "Full name"
                  },
                  "email": {
                    "type": "string",
                    "description": "Email address"
                  },
                  "department": {
                    "type": "object",
                    "description": "ANTI-PATTERN: Nested object in requestBody. Agent cannot fill nested fields. Should be flattened to department_name, department_location.",
                    "properties": {
                      "id": { "type": "integer" },
                      "name": { "type": "string" },
                      "location": { "type": "string" }
                    },
                    "required": ["name"]
                  },
                  "job_title": {
                    "type": "string",
                    "description": "Job title"
                  },
                  "compensation": {
                    "type": "object",
                    "description": "ANTI-PATTERN: Nested object for salary info. Agent cannot fill nested fields. Should be flattened to base_salary, bonus.",
                    "properties": {
                      "base_salary": { "type": "integer" },
                      "bonus": { "type": "integer" },
                      "currency": { "type": "string" }
                    },
                    "required": ["base_salary"]
                  },
                  "employment_status": {
                    "type": "string",
                    "description": "ANTI-PATTERN: No enum. Agent may guess wrong values. Should have enum: [Active, Inactive]."
                  },
                  "contract_period": {
                    "type": "object",
                    "description": "ANTI-PATTERN: Nested date range. Agent cannot fill start/end inside a nested object. Should be flattened to hire_date, contract_end_date.",
                    "properties": {
                      "start_date": {
                        "type": "string",
                        "format": "date"
                      },
                      "end_date": {
                        "anyOf": [
                          { "type": "string", "format": "date" },
                          { "type": "null" }
                        ],
                        "description": "ANTI-PATTERN: anyOf with null. Agent does not know which type to use."
                      }
                    },
                    "required": ["start_date"]
                  },
                  "skills": {
                    "type": "array",
                    "description": "ANTI-PATTERN: Array of strings. Array types are NOT SUPPORTED in requestBody. Should be a comma-separated string.",
                    "items": {
                      "type": "string"
                    }
                  },
                  "certifications": {
                    "type": "array",
                    "description": "ANTI-PATTERN: Array of objects. Even worse than array of strings. Agent cannot construct arrays of structured objects.",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": { "type": "string" },
                        "issued_date": { "type": "string", "format": "date" }
                      }
                    }
                  },
                  "manager": {
                    "type": "object",
                    "description": "ANTI-PATTERN: Nested object. Should be flattened to manager_name.",
                    "properties": {
                      "id": {
                        "anyOf": [
                          { "type": "integer" },
                          { "type": "null" }
                        ],
                        "description": "ANTI-PATTERN: anyOf with null."
                      },
                      "name": {
                        "anyOf": [
                          { "type": "string" },
                          { "type": "null" }
                        ],
                        "description": "ANTI-PATTERN: anyOf with null."
                      }
                    }
                  }
                },
                "required": ["employee_name", "department", "job_title", "compensation", "employment_status"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created employee",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Employee"
                }
              }
            }
          }
        }
      }
    },
    "/employees/{id}": {
      "get": {
        "operationId": "GetEmployeeById",
        "description": "Get a single employee by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ANTI-PATTERN: Non-descriptive param name. Should be employeeId.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employee details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Employee"
                }
              }
            }
          }
        }
      }
    },
